# Server
PORT=3000

# Database (Sequelize / SQLite)
DB_PATH=./dev.sqlite
DB_USER=root
DB_PASS=
DB_ADAPTER=sequelize

# Auth
# Create test by running openssl rand -hex 32
JWT_SECRET=change_me_to_a_long_random_string
JWT_LIFETIME=1h
COOKIE_SECRET=change_me_to_another_long_random_string

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=60

# Redis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASS=
